# Template only. Recommended: run `python scripts/bootstrap.py` from the project root.
# If copying this file manually, place it at the repository root as `.env` and replace every sample.
APP_ENV=production
AUTH_ENABLED=true
POSTGRES_PASSWORD=root
DATABASE_URL=postgresql+psycopg://app:root@localhost:5433/shortener
REDIS_URL=redis://localhost:6379/1
# JSON object: API_KEY (at least 24 characters) -> "tenant-subject:role".
ORCHESTRATOR_API_KEYS={"replace-with-admin-key-at-least-24-characters":"platform-admin:admin","replace-with-developer-key-at-least-24-characters":"team-a:developer","replace-with-reviewer-key-at-least-24-characters":"team-a:reviewer","replace-with-viewer-key-at-least-24-characters":"team-a:viewer"}
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_FAIL_CLOSED=true
AGENT_WORKSPACE_ROOT=../.agentic-workspaces
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-grafana-password
